# Copy to .env.local for local development. Both values are on your Supabase
# project's Settings -> API page. The anon key is safe to put in a website;
# the database rules in supabase/setup.sql are what keep the journal private.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
